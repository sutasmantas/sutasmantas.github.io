---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, routes, counts } from '../../data/portfolio.js';

// Ordered by the taxonomy route, then by featured rank, so the list opens on the
// work with the strongest evidence rather than in alphabetical accident.
const ordered = [...projects].sort(
  (a, b) => (a.featured ?? 99) - (b.featured ?? 99),
);
---
<Base
  title={`${counts.open} systems you can open — Mantas Šutas`}
  description="Every AI system in this portfolio, filterable by the way a client would describe the problem. Each one runs on a public URL and states the limit of what it proves."
>
  <div class="wrap head">
    <p class="kick mono">Evidence</p>
    <h1>All {counts.open} systems, open in a browser.</h1>
    <p class="sub">
      No login and no sales call first. Filter by the way you would describe the
      problem. Every card names the limit of what it proves, because a demo that
      hides its boundary is not evidence.
    </p>
  </div>

  <div class="wrap bar">
    <fieldset class="filter">
      <legend class="sr">Filter by what you need</legend>
      <button type="button" class="chip on" data-route="all" aria-pressed="true" data-label="Everything">
        Everything <span class="n mono">{counts.open}</span>
      </button>
      {routes.map((r) => (
        <button type="button" class="chip" data-route={r.id} aria-pressed="false" data-label={r.chip}>
          {r.chip}
          <span class="n mono">{projects.filter((p) => p.route === r.id).length}</span>
        </button>
      ))}
    </fieldset>
    <p class="status mono" role="status" aria-live="polite" data-status>
      Showing all {counts.open}
    </p>
  </div>

  <div class="wrap grid" data-list>
    {ordered.map((p) => <ProjectCard project={p} showLimit={true} />)}
  </div>

  <div class="wrap note">
    <p>
      One more system — a realtime English and Lithuanian context assistant — is
      built but has no reconciled public repository yet. It gets no card here,
      because a card on this page is a promise that you can open the thing.
    </p>
  </div>

<style>
  .head { padding-block: 64px 30px; max-width: 780px; }
  .kick {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 18px;
    font-size: 11.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--accent);
  }
  .kick::before { content: ""; width: 22px; height: 1px; background: var(--accent-dim); }
  h1 {
    font-size: clamp(1.95rem, 4vw, 2.7rem); line-height: 1.08; letter-spacing: -.03em;
    margin: 0 0 16px; text-wrap: balance;
  }
  .sub { color: var(--text-2); margin: 0; max-width: 60ch; }

  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
    flex-wrap: wrap; padding-block: 8px 26px;
    position: sticky; top: 58px; z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .filter { display: flex; gap: 9px; flex-wrap: wrap; border: 0; margin: 0; padding: 0; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: var(--text-2); cursor: pointer;
    border: 1px solid var(--line-ctl); border-radius: 999px;
    padding: 8px 15px; font: inherit; font-size: 13.5px;
  }
  .chip .n { font-size: 11px; color: var(--muted); }
  .chip.on {
    background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 650;
  }
  .chip.on .n { color: var(--accent-ink); opacity: .72; }
  .status { font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0; }

  .grid {
    display: grid; gap: 20px; padding-bottom: 20px;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
  }
  .grid :global(.card[hidden]) { display: none; }

  .note { padding-block: 26px 78px; }
  .note p {
    margin: 0; max-width: 62ch; color: var(--muted); font-size: 13.5px;
    border-left: 2px solid var(--line-bright); padding-left: 14px;
  }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: 24px; } }
  @media (max-width: 620px) {
    .head { padding-block: 44px 24px; }
    .bar { padding-bottom: 20px; gap: 12px; }
    .filter { gap: 8px; }
    .chip { padding: 9px 14px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .chip { transition: border-color .15s ease, background-color .15s ease, color .15s ease; }
  }
</style>

<script>
  // Progressive enhancement: without JavaScript every card is already in the
  // document and visible, and the filter simply does nothing. The route is
  // also readable from ?route= so the links on the home page land pre-filtered
  // and the filtered view can be shared.
  const chips = Array.from(document.querySelectorAll('.chip'));
  const cards = Array.from(document.querySelectorAll('[data-list] .card'));
  const status = document.querySelector('[data-status]');

  function apply(route, push) {
    let shown = 0;
    for (const card of cards) {
      const match = route === 'all' || card.dataset.route === route;
      card.hidden = !match;
      if (match) shown += 1;
    }
    for (const chip of chips) {
      const on = chip.dataset.route === route;
      chip.classList.toggle('on', on);
      chip.setAttribute('aria-pressed', String(on));
    }
    const label = chips.find((c) => c.dataset.route === route)?.dataset.label ?? route;
    status.textContent =
      route === 'all'
        ? `Showing all ${shown}`
        : `Showing ${shown} of ${cards.length} — ${label}`;
    if (push) {
      const url = new URL(window.location.href);
      if (route === 'all') url.searchParams.delete('route');
      else url.searchParams.set('route', route);
      history.replaceState(null, '', url);
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => apply(chip.dataset.route, true));
  }

  const initial = new URLSearchParams(window.location.search).get('route');
  if (initial && chips.some((c) => c.dataset.route === initial)) apply(initial, false);
</script>
</Base>
