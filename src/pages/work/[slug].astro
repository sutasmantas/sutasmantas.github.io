---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects, routeLabel, contact } from '../../data/portfolio.js';
import { shotFor } from '../../data/shots.js';
import { href, homeAnchor, homeFiltered } from '../../lib/paths.js';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project: p } = Astro.props;
const img = shotFor(p.shot);
const siblings = projects.filter((s) => s.route === p.route && s.slug !== p.slug);
---
<Base
  title={`${p.name} — ${p.asks} — Mantas Šutas`}
  description={p.blurb}
>
  <div class="wrap head">
    <nav class="crumbs mono label" aria-label="Breadcrumb">
      <a href={homeAnchor('work')}>The work</a><span aria-hidden="true">/</span><span>{p.name}</span>
    </nav>
    <p class="kick mono label">{p.family}</p>
    <h1>{p.title}</h1>
    <p class="sub">{p.blurb}</p>
    <div class="ctas">
      <a class="btn" href={p.live}>Open the live system</a>
      <a class="btn ghost" href={p.source}>Read the source</a>
    </div>
  </div>

  <!-- The window frame is a child of .wrap, not the same element. Putting both on
       one element meant the frame's own padding fought the page gutter and the
       border ended up flush against the screen edge on a phone. -->
  <div class="wrap">
  <figure class="win">
    <div class="win-bar">
      <span class="dot live" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
      <span class="addr mono">{p.live.replace('https://', '')}</span>
      <span class="badge">live · no login</span>
    </div>
    <div class="shot">
      <Image src={img} alt={p.alt} widths={[760, 1150, 1440]} sizes="(max-width: 1250px) 94vw, 1150px" loading="eager" />
    </div>
  </figure>
  </div>

  <section class="wrap facts" aria-label="What this project is">
    <dl>
      <div><dt class="label">What you get</dt><dd>{p.asks}</dd></div>
      <div><dt class="label">Route</dt><dd><a href={homeFiltered(p.route)}>{routeLabel[p.route]}</a></dd></div>
      <div><dt class="label">Area</dt><dd>{p.family}</dd></div>
      {p.note && <div><dt class="label">The hard part</dt><dd>{p.note}</dd></div>}
    </dl>
  </section>

  <section class="wrap block">
    <h2>What you can check today</h2>
    <p class="scope">{p.scope}</p>
    <p class="lede">
      The repository holds the tests behind this, and the failures they were
      written against. If you want it pointed at your own systems and your own
      data, that is the conversation — tell me what you are trying to fix.
    </p>
    <div class="ctas">
      <a class="btn" href={`mailto:${contact.email}?subject=${encodeURIComponent(p.name)}`}>Talk about {p.name}</a>
      <a class="btn ghost" href={p.source}>Source and tests</a>
    </div>
  </section>

  {siblings.length > 0 && (
    <section class="wrap block related">
      <h2>Others that do this</h2>
      <ul>
        {siblings.map((s) => (
          <li>
            <a href={href(`/work/${s.slug}/`)}>
              <b>{s.name}</b>
              <span>{s.asks}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

<style>
  .head { padding-block: var(--s-12) var(--s-8); max-width: 50rem; }
  .crumbs { color: var(--muted); margin-bottom: var(--s-6); }
  .crumbs a { color: var(--text-2); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .crumbs span[aria-hidden] { margin: 0 var(--s-2); color: var(--line-bright); }
  .kick { color: var(--accent); margin-bottom: var(--s-3); }
  h1 {
    font-size: clamp(1.75rem, 3.4vw, 2.375rem);
    line-height: 1.15; letter-spacing: -0.026em; margin-bottom: var(--s-4);
  }
  .sub { color: var(--text-2); margin-bottom: var(--s-8); max-width: 58ch; font-size: var(--t-500); }
  .ctas { display: flex; gap: var(--s-3); flex-wrap: wrap; }
  .btn {
    background: var(--accent); color: var(--accent-ink);
    padding: var(--s-3) var(--s-5); border-radius: var(--r-md);
    font-weight: 650; font-size: var(--t-400);
    text-decoration: none; white-space: nowrap; box-shadow: var(--sh-1);
  }
  .btn:hover { background: color-mix(in srgb, var(--accent) 88%, #fff); box-shadow: var(--sh-2); }
  .btn.ghost {
    background: transparent; color: var(--text);
    border: 1px solid var(--line-ctl); font-weight: 600; box-shadow: none;
  }
  .btn.ghost:hover { background: color-mix(in srgb, var(--text) 7%, transparent); border-color: var(--text-2); }

  .win {
    border: 1px solid var(--line-ctl); border-radius: var(--r-lg); overflow: hidden;
    background: var(--panel); box-shadow: var(--sh-3);
    max-width: 1150px; margin: var(--s-4) auto 0;
  }
  .win-bar {
    display: flex; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-3);
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    border-bottom: 1px solid var(--line);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-bright); flex: 0 0 auto; }
  .dot.live { background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent); }
  .addr { font-size: var(--t-100); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .badge {
    margin-left: auto; flex: 0 0 auto; font-size: var(--t-100);
    letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--accent);
    border: 1px solid var(--accent-dim); border-radius: var(--r-sm); padding: 2px var(--s-2);
  }
  .shot { background: var(--mat); padding: var(--s-3) var(--s-3) 0; overflow: hidden; }
  .shot :global(img) { display: block; width: 100%; height: auto; border-radius: var(--s-1) var(--s-1) 0 0; }

  .facts { padding-block: var(--s-10) 0; }
  .facts dl {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px; margin: 0; background: var(--line);
    border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden;
  }
  .facts dl > div { background: var(--panel); padding: var(--s-4) var(--s-5); display: grid; gap: var(--s-1); }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-size: var(--t-300); line-height: 1.45; }
  .facts dd a { color: var(--accent); text-decoration: none; }

  .block { padding-block: var(--s-12) 0; }
  .scope {
    margin-bottom: var(--s-5); font-size: var(--t-500); color: var(--text);
    border-left: 2px solid var(--accent-dim); padding-left: var(--s-4); max-width: 58ch;
  }
  .lede { color: var(--text-2); max-width: var(--measure); margin-bottom: var(--s-6); }
  h2 { margin-bottom: var(--s-4); }

  .related { padding-bottom: var(--s-20); }
  .related ul {
    list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .related a {
    display: grid; gap: var(--s-1); text-decoration: none;
    border: 1px solid var(--line); border-radius: var(--r-md);
    background: var(--panel); padding: var(--s-4) var(--s-5);
  }
  .related b { font-size: var(--t-400); }
  .related span { font-size: var(--t-200); color: var(--muted); }
  .related a:hover { border-color: var(--line-bright); background: var(--panel-2); }

  @media (max-width: 620px) {
    .head { padding-block: var(--s-10) var(--s-6); }
    .ctas .btn { flex: 1 1 100%; text-align: center; }
    .shot { height: 236px; padding: var(--s-2) var(--s-2) 0; }
    .shot :global(img) { width: 190%; max-width: none; transform: translateY(-5%); }
    .block { padding-block: var(--s-10) 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .related a, .btn { transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease), color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  }
</style>
</Base>
