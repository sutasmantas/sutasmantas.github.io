---
import Base from '../layouts/Base.astro';
import SystemIndex from '../components/SystemIndex.astro';
import { identity, proof, routes, counts, projects } from '../data/portfolio.js';
import { homeFiltered } from '../lib/paths.js';

const routeCount = (id) => projects.filter((p) => p.route === id).length;
---
<Base
  title="Mantas Šutas — Independent AI engineer · 13 systems you can open"
  description="Independent AI engineer. Thirteen AI systems — agent workflows, voice intake, retrieval, document pipelines and computer vision — all live, all open source, all shipped with their tests."
>
  <!-- The composition, not the tokens, is what made this page read as a
       template: every band had the same height, density and weight, so nothing
       could dominate and nothing could recede. Scale variation between sections
       is the fix — an airy hero at display size against a dense ruled index. -->
  <header class="hero">
    <div class="wrap">
      <p class="eyebrow mono label">{identity.role} · {identity.locale}</p>
      <h1>Thirteen AI systems<br /><em>you can open right now.</em></h1>

      <div class="under">
        <p class="sub">{identity.sub}</p>
        <dl class="figs">
          {proof.map((f) => (
            <div>
              <dt class="mono">{f.value}</dt>
              <dd class="mono label">{f.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="ctas">
        <a class="btn" href="#work">See the work</a>
        <a class="btn ghost" href="#help">What I could build for you</a>
      </div>
    </div>
  </header>

  <section class="block work" id="work">
    <div class="wrap">
      <div class="sec-head">
        <h2>The work</h2>
        <div class="filter-wrap">
          <fieldset class="filter">
            <legend class="sr">Filter by what you need done</legend>
            <button type="button" class="chip on" data-route="all" aria-pressed="true" data-label="Everything">
              All <span class="n mono">{counts.open}</span>
            </button>
            {routes.map((r) => (
              <button type="button" class="chip" data-route={r.id} aria-pressed="false" data-label={r.chip}>
                {r.chip} <span class="n mono">{routeCount(r.id)}</span>
              </button>
            ))}
          </fieldset>
          <p class="status mono label" role="status" aria-live="polite" data-status>All {counts.open}</p>
        </div>
      </div>

      <SystemIndex />
    </div>
  </section>

  <section class="block help" id="help">
    <div class="wrap">
      <div class="sec-head">
        <h2>What I could build for you</h2>
        <span class="count mono label">three routes</span>
      </div>
      <div class="routes">
        {routes.map((r) => (
          <a class="route" href={homeFiltered(r.id)}>
            <h3>{r.title}</h3>
            <p>{r.blurb}</p>
            <ul class="does">{r.does.map((d) => <li>{d}</li>)}</ul>
            <span class="n mono label">{routeCount(r.id)} systems →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

<style>
  /* ---------- hero: the airy half of the page ---------- */
  .hero { padding-block: var(--s-20) var(--s-16); border-bottom: 1px solid var(--line); }
  .eyebrow {
    display: inline-flex; align-items: center; gap: var(--s-3);
    color: var(--accent); margin-bottom: var(--s-8);
  }
  .eyebrow::before { content: ""; width: var(--s-8); height: 1px; background: var(--accent-dim); }

  /* Display scale. The previous headline topped out at 3.5rem, which is a
     heading, not a display size; this is the page's one dominant element. */
  .hero h1 {
    font-size: clamp(2.6rem, 8.2vw, 6.5rem);
    line-height: 0.98; letter-spacing: -0.04em; font-weight: 700;
    margin-bottom: var(--s-12); max-width: 16ch;
  }
  .hero h1 em { font-style: normal; color: var(--accent); }

  /* Asymmetric: a narrow measure of prose against a wide figure rail, rather
     than the two equal columns everything else on the web uses. */
  .under {
    display: grid; grid-template-columns: minmax(0, 34ch) minmax(0, 1fr);
    gap: var(--s-12); align-items: start;
    padding-top: var(--s-8); border-top: 1px solid var(--line);
  }
  .sub { color: var(--text-2); font-size: var(--t-500); }

  .figs { display: flex; gap: var(--s-12); margin: 0; flex-wrap: wrap; }
  .figs div { display: grid; gap: var(--s-1); }
  .figs dt { font-size: var(--t-800); line-height: 1; letter-spacing: -0.02em; font-weight: 600; }
  .figs dd { margin: 0; color: var(--muted); max-width: 15ch; }

  .ctas { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-10); }
  .btn {
    background: var(--accent); color: var(--accent-ink);
    padding: var(--s-3) var(--s-5); border-radius: var(--r-md);
    font-weight: 650; font-size: var(--t-400);
    text-decoration: none; white-space: nowrap; box-shadow: var(--sh-1);
  }
  .btn:hover { background: color-mix(in srgb, var(--accent) 88%, #fff); box-shadow: var(--sh-2); }
  .btn.ghost {
    background: transparent; color: var(--text);
    border: 1px solid var(--line-ctl); font-weight: 600; box-shadow: none;
  }
  .btn.ghost:hover { background: color-mix(in srgb, var(--text) 7%, transparent); border-color: var(--text-2); }

  /* ---------- sections ---------- */
  .block { padding-block: var(--s-16); }
  .work { padding-bottom: var(--s-20); }
  .help { border-top: 1px solid var(--line); background: var(--bg-lift); }

  .sec-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--s-6); flex-wrap: wrap; margin-bottom: var(--s-8);
  }
  .sec-head h2 { font-size: var(--t-800); letter-spacing: -0.028em; }
  .count { color: var(--muted); }

  .filter-wrap { display: flex; align-items: center; gap: var(--s-4); flex-wrap: wrap; }
  .filter { display: flex; gap: var(--s-2); flex-wrap: wrap; border: 0; margin: 0; padding: 0; }
  .chip {
    display: inline-flex; align-items: center; gap: var(--s-2);
    background: transparent; color: var(--text-2); cursor: pointer;
    border: 1px solid var(--line-ctl); border-radius: var(--r-pill);
    padding: var(--s-2) var(--s-4); font: inherit; font-size: var(--t-300);
  }
  .chip:hover { border-color: var(--text-2); color: var(--text); }
  .chip .n { font-size: var(--t-100); color: var(--muted); }
  .chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 650; }
  .chip.on .n { color: var(--accent-ink); opacity: 0.72; }
  .status { color: var(--muted); }

  .routes { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .route {
    display: flex; flex-direction: column; gap: var(--s-3); text-decoration: none;
    background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: var(--s-6); box-shadow: var(--sh-1);
  }
  .route p { color: var(--text-2); font-size: var(--t-400); }
  .does {
    list-style: none; margin: 0; padding: var(--s-4) 0 0; flex: 1;
    border-top: 1px solid var(--line); display: grid; gap: var(--s-2);
  }
  .does li { position: relative; padding-left: var(--s-5); font-size: var(--t-300); color: var(--text); }
  .does li::before {
    content: ""; position: absolute; left: 0; top: 0.55em;
    width: 5px; height: 5px; border-radius: 1px; background: var(--accent-dim);
  }
  .route .n { color: var(--accent); }

  @media (max-width: 900px) {
    .hero { padding-block: var(--s-12) var(--s-10); }
    .hero h1 { margin-bottom: var(--s-8); }
    .under { grid-template-columns: 1fr; gap: var(--s-8); }
    .figs { gap: var(--s-8); }
    .routes { grid-template-columns: 1fr; }
    .block { padding-block: var(--s-12); }
  }
  @media (max-width: 620px) {
    .ctas .btn { flex: 1 1 100%; text-align: center; }
    .figs { gap: var(--s-6); }
    .figs dt { font-size: var(--t-700); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip, .btn { transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
    .route { transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
    .route:hover { border-color: var(--line-bright); transform: translateY(-2px); box-shadow: var(--sh-2); }
  }
</style>

<script>
  // Filters the index rows. Progressive enhancement: without JavaScript every
  // row is present and visible and the chips do nothing.
  const chips = Array.from(document.querySelectorAll('.chip'));
  const rows = Array.from(document.querySelectorAll('[data-rows] .row'));
  const status = document.querySelector('[data-status]');

  function apply(route, push) {
    let shown = 0;
    for (const row of rows) {
      const match = route === 'all' || row.dataset.route === route;
      row.hidden = !match;
      if (match) shown += 1;
    }
    for (const chip of chips) {
      const on = chip.dataset.route === route;
      chip.classList.toggle('on', on);
      chip.setAttribute('aria-pressed', String(on));
    }
    const label = chips.find((c) => c.dataset.route === route)?.dataset.label ?? route;
    status.textContent = route === 'all' ? `All ${shown}` : `${shown} of ${rows.length} — ${label}`;
    if (push) {
      const url = new URL(window.location.href);
      if (route === 'all') url.searchParams.delete('route');
      else url.searchParams.set('route', route);
      history.replaceState(null, '', url);
    }
  }

  for (const chip of chips) chip.addEventListener('click', () => apply(chip.dataset.route, true));

  const initial = new URLSearchParams(window.location.search).get('route');
  if (initial && chips.some((c) => c.dataset.route === initial)) apply(initial, false);
</script>
</Base>
