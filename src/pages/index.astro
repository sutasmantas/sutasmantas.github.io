---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { identity, proof, routes, ordered, counts, projects } from '../data/portfolio.js';
import { shotFor } from '../data/shots.js';
import { href, homeFiltered } from '../lib/paths.js';

const hero = projects.find((p) => p.slug === 'relay'); // strongest reliability evidence
const heroImg = shotFor(hero.shot);
const routeCount = (id) => projects.filter((p) => p.route === id).length;
---
<Base
  title="Mantas Šutas — Independent AI engineer · 13 systems you can open"
  description="Independent AI engineer. Thirteen AI systems — agent workflows, voice intake, retrieval, document pipelines and computer vision — all live, all open source, all shipped with their tests."
>
  <!-- Hero: a real running interface in the fold. The whole argument of this
       page is that the systems can be opened, so the fold has to show one. -->
  <div class="wrap hero">
    <div class="say">
      <p class="kick mono label">{identity.role} · {identity.locale}</p>
      <h1>{identity.headline[0]} <em>{identity.headline[1]}</em>.</h1>
      <p class="sub">{identity.sub}</p>
      <div class="ctas">
        <a class="btn" href="#work">See all 13 systems</a>
        <a class="btn ghost" href="#help">Ways I can help</a>
      </div>
    </div>

    <figure class="win">
      <div class="win-bar">
        <span class="dot live" aria-hidden="true"></span>
        <span class="dot" aria-hidden="true"></span>
        <span class="dot" aria-hidden="true"></span>
        <span class="addr mono">{hero.slug} · {hero.family.toLowerCase()}</span>
        <span class="badge">live · no login</span>
      </div>
      <div class="shot">
        <Image src={heroImg} alt={hero.alt} widths={[700, 1100, 1440]} sizes="(max-width: 900px) 94vw, 620px" loading="eager" />
      </div>
      <figcaption>
        <a href={hero.live}>Open {hero.name} →</a>
        <span>{hero.note}</span>
      </figcaption>
    </figure>
  </div>

  <!-- Proof strip. Both closest references put client logos here. This has none,
       so it uses owned figures that each trace to a receipt. -->
  <section class="readout" aria-label="Portfolio at a glance">
    <div class="wrap grid">
      {proof.map((f) => (
        <div class="cell">
          <b class="mono">{f.value}{f.unit && <span class="u"> {f.unit}</span>}</b>
          <span class="lbl label">{f.label}</span>
          <span class="sub2">{f.sub}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap block" id="help">
    <div class="sec-head">
      <h2>Ways I can help</h2>
      <span class="count mono label">three routes</span>
    </div>
    <p class="lede">
      Pick whichever sounds like your problem. Each one goes straight to systems
      that already do it — running, not described.
    </p>
    <div class="routes">
      {routes.map((r) => (
        <a class="route" href={homeFiltered(r.id)}>
          <h3>{r.title}</h3>
          <p>{r.blurb}</p>
          <ul class="does">
            {r.does.map((d) => <li>{d}</li>)}
          </ul>
          <span class="n mono">{routeCount(r.id)} systems you can open →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap block" id="work">
    <div class="sec-head">
      <h2>All {counts.open} systems</h2>
      <span class="count mono label">every one is live</span>
    </div>
    <p class="lede">
      Working software on public URLs, not screenshots of things that once
      worked. Open any of them and click around before you decide whether to
      email me.
    </p>

    <div class="bar">
      <fieldset class="filter">
        <legend class="sr">Filter by what you need done</legend>
        <button type="button" class="chip on" data-route="all" aria-pressed="true" data-label="Everything">
          Everything <span class="n mono">{counts.open}</span>
        </button>
        {routes.map((r) => (
          <button type="button" class="chip" data-route={r.id} aria-pressed="false" data-label={r.chip}>
            {r.chip}
            <span class="n mono">{routeCount(r.id)}</span>
          </button>
        ))}
      </fieldset>
      <p class="status mono label" role="status" aria-live="polite" data-status>
        Showing all {counts.open}
      </p>
    </div>

    <div class="cards" data-list>
      {ordered.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-12); align-items: center; padding-block: var(--s-20) var(--s-16);
  }
  .kick {
    display: inline-flex; align-items: center; gap: var(--s-3);
    color: var(--accent); margin-bottom: var(--s-6);
  }
  .kick::before { content: ""; width: var(--s-6); height: 1px; background: var(--accent-dim); }
  h1 {
    font-size: var(--t-900); line-height: var(--lh-display);
    letter-spacing: var(--ls-display); margin-bottom: var(--s-5); font-weight: 700;
  }
  h1 em { font-style: normal; color: var(--accent); }
  .sub {
    color: var(--text-2); margin-bottom: var(--s-8);
    max-width: 46ch; font-size: var(--t-500);
  }
  .ctas { display: flex; gap: var(--s-3); align-items: center; flex-wrap: wrap; }
  .btn {
    background: var(--accent); color: var(--accent-ink);
    padding: var(--s-3) var(--s-5); border-radius: var(--r-md);
    font-weight: 650; font-size: var(--t-400);
    text-decoration: none; white-space: nowrap; box-shadow: var(--sh-1);
  }
  .btn:hover { background: color-mix(in srgb, var(--accent) 88%, #fff); box-shadow: var(--sh-2); }
  .btn.ghost {
    background: transparent; color: var(--text);
    border: 1px solid var(--line-ctl); font-weight: 600; box-shadow: none;
  }
  .btn.ghost:hover { background: color-mix(in srgb, var(--text) 7%, transparent); border-color: var(--text-2); }

  /* window chrome: reads as a running app, not a picture */
  .win {
    margin: 0; border: 1px solid var(--line-ctl); border-radius: var(--r-lg);
    overflow: hidden; background: var(--panel); box-shadow: var(--sh-3);
  }
  .win-bar {
    display: flex; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-3);
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    border-bottom: 1px solid var(--line);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-bright); flex: 0 0 auto; }
  .dot.live { background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent); }
  .addr { font-size: var(--t-100); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .badge {
    margin-left: auto; flex: 0 0 auto; font-size: var(--t-100);
    letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--accent);
    border: 1px solid var(--accent-dim); border-radius: var(--r-sm); padding: 2px var(--s-2);
  }
  /* mat: the real UIs were designed on white and hit the ground at 19:1.
     Stepping through the mat brings the edge to 13:1. */
  .shot { background: var(--mat); padding: var(--s-2) var(--s-2) 0; overflow: hidden; }
  .shot :global(img) { display: block; width: 100%; height: auto; border-radius: var(--s-1) var(--s-1) 0 0; }
  .win figcaption {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-3);
    padding: var(--s-3); border-top: 1px solid var(--line); background: var(--panel-2);
    font-size: var(--t-300);
  }
  .win figcaption a {
    display: inline-flex; align-items: center; min-height: 26px;
    color: var(--accent); text-decoration: none; font-weight: 600;
  }
  .win figcaption span { color: var(--muted); font-size: var(--t-200); text-align: right; }

  /* ---------- readout ---------- */
  .readout { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg-lift); }
  .readout .grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .cell { padding: var(--s-6) var(--gut); border-right: 1px solid var(--line); }
  .cell:last-child { border-right: 0; }
  .cell b {
    display: block; font-size: var(--t-800); line-height: 1.1;
    letter-spacing: var(--ls-head); font-weight: 600;
  }
  .cell b .u { font-size: var(--t-400); color: var(--muted); letter-spacing: 0; }
  .cell .lbl { display: block; margin-top: var(--s-2); color: var(--text-2); }
  .cell .sub2 { display: block; margin-top: var(--s-1); font-size: var(--t-200); color: var(--muted); }

  /* ---------- sections ---------- */
  .block { padding-block: var(--s-20); }
  .sec-head { display: flex; align-items: baseline; gap: var(--s-3); margin-bottom: var(--s-3); flex-wrap: wrap; }
  .count { color: var(--muted); }
  .lede { color: var(--text-2); margin-bottom: var(--s-8); max-width: var(--measure); }

  .routes { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .route {
    display: flex; flex-direction: column; gap: var(--s-3); text-decoration: none;
    background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: var(--s-6); box-shadow: var(--sh-1);
  }
  .route p { color: var(--text-2); font-size: var(--t-400); }
  /* Concrete deliverables under each pillar, so a visitor recognises their own
     job rather than reading a capability list. */
  .does {
    list-style: none; margin: 0; padding: var(--s-4) 0 0; flex: 1;
    border-top: 1px solid var(--line); display: grid; gap: var(--s-2);
  }
  .does li { position: relative; padding-left: var(--s-5); font-size: var(--t-300); color: var(--text); }
  .does li::before {
    content: ""; position: absolute; left: 0; top: 0.55em;
    width: 5px; height: 5px; border-radius: 1px; background: var(--accent-dim);
  }
  .n { font-size: var(--t-200); color: var(--accent); white-space: nowrap; }

  .cards { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); }
  .cards :global(.card[hidden]) { display: none; }

  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    flex-wrap: wrap; margin-bottom: var(--s-6);
  }
  .filter { display: flex; gap: var(--s-2); flex-wrap: wrap; border: 0; margin: 0; padding: 0; }
  .chip {
    display: inline-flex; align-items: center; gap: var(--s-2);
    background: transparent; color: var(--text-2); cursor: pointer;
    border: 1px solid var(--line-ctl); border-radius: var(--r-pill);
    padding: var(--s-2) var(--s-4); font: inherit; font-size: var(--t-300);
  }
  .chip:hover { border-color: var(--text-2); color: var(--text); }
  .chip .n { font-size: var(--t-100); color: var(--muted); }
  .chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 650; }
  .chip.on:hover { background: color-mix(in srgb, var(--accent) 88%, #fff); }
  .chip.on .n { color: var(--accent-ink); opacity: 0.72; }
  .status { color: var(--muted); }

  /* ---------- mobile: designed, not left to wrap ---------- */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: var(--s-10); padding-block: var(--s-12) var(--s-10); }
    .readout .grid { grid-template-columns: 1fr; }
    .cell { border-right: 0; border-top: 1px solid var(--line); }
    .cell:first-child { border-top: 0; }
    .cards, .routes { grid-template-columns: 1fr; gap: var(--s-6); }
    .block { padding-block: var(--s-16); }
  }
  @media (max-width: 620px) {
    h1 { font-size: clamp(2rem, 8.4vw, 2.5rem); letter-spacing: -0.028em; }
    .ctas .btn { flex: 1 1 100%; text-align: center; }
    /* A 1440px interface scaled to 390px is an unreadable smudge, which defeats
       the point of putting it in the fold. Show a legible crop instead. */
    .shot { height: 240px; }
    .shot :global(img) { width: 215%; max-width: none; transform: translateY(-5%); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip { transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease), color var(--dur) var(--ease); }
    .route { transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
    .route:hover { border-color: var(--line-bright); transform: translateY(-2px); box-shadow: var(--sh-2); }
    .btn { transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  }
</style>

<script>
  // Progressive enhancement: every card is already in the document and visible,
  // so with JavaScript off the filter simply does nothing and all thirteen are
  // still there. ?route= is read on load, so the "Ways I can help" cards land
  // pre-filtered and a filtered view can be shared.
  const chips = Array.from(document.querySelectorAll('.chip'));
  const cards = Array.from(document.querySelectorAll('[data-list] .card'));
  const status = document.querySelector('[data-status]');

  function apply(route, push) {
    let shown = 0;
    for (const card of cards) {
      const match = route === 'all' || card.dataset.route === route;
      card.hidden = !match;
      if (match) shown += 1;
    }
    for (const chip of chips) {
      const on = chip.dataset.route === route;
      chip.classList.toggle('on', on);
      chip.setAttribute('aria-pressed', String(on));
    }
    const label = chips.find((c) => c.dataset.route === route)?.dataset.label ?? route;
    status.textContent =
      route === 'all' ? `Showing all ${shown}` : `Showing ${shown} of ${cards.length} — ${label}`;
    if (push) {
      const url = new URL(window.location.href);
      if (route === 'all') url.searchParams.delete('route');
      else url.searchParams.set('route', route);
      history.replaceState(null, '', url);
    }
  }

  for (const chip of chips) chip.addEventListener('click', () => apply(chip.dataset.route, true));

  const initial = new URLSearchParams(window.location.search).get('route');
  if (initial && chips.some((c) => c.dataset.route === initial)) apply(initial, false);
</script>
</Base>
