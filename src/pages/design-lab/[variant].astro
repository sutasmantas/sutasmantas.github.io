---
import Lab from '../../layouts/Lab.astro';
import DesignExperiment from '../../components/design-lab/DesignExperiment.astro';

export function getStaticPaths() {
  const titles = {
    '01': 'Systems broadsheet',
    '02': 'Person × product hero',
    '03': 'Variable-width type specimen',
    '04': 'Guided live-system stage',
    '05': 'Project evidence lens',
  '06': 'Comparison reference — complete identity registry',
    '07': 'Executable evidence receipt',
    '08': 'Project-detail case spine',
    '09': 'Engineering field notes',
    '10': 'Selected base — complete motion proof deck',
    '11': 'Signal perimeter',
    '12': 'Cursor-lit proof deck',
    '13': 'Product inspection lens',
    '14': 'Interactive systems grid',
    '15': 'Tactile evidence field',
    '16': 'Shimmer-selected directory',
    '17': 'Spectral headline',
    '18': 'Blur-resolve proof transition',
    '19': 'Directional screenshot reveal',
    '20': 'Dimensional proof stack',
    '21': 'Combined selected base',
    '22': 'Magnetic project actions',
    '23': 'Glare-inspected screenshots',
    '24': 'Pixel-resolve project transition',
    '25': 'Dock-magnified directory',
    '26': 'Decrypted project title',
    '27': 'Interactive proof ticker',
    '28': 'Selection spark feedback',
    '29': 'Line-shadow project title',
    '30': 'Expanding proof screenshot',
    '31': 'Flowing project directory',
  };
  return Object.entries(titles).map(([variant, title]) => ({
    params: { variant },
    props: { variant, title },
  }));
}

const { variant, title } = Astro.props;
---
<Lab title={title} variant={variant}>
  <DesignExperiment variant={variant} title={title} />
</Lab>
