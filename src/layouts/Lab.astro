---
import '../styles/tokens.css';
import { href } from '../lib/paths.js';
import sansLatin from '../assets/fonts/plex-sans-var-latin.woff2';
import sansLatinExt from '../assets/fonts/plex-sans-var-latin-ext.woff2';

const { title, variant } = Astro.props;
const variants = Array.from({ length: 11 }, (_, index) => String(index + 10).padStart(2, '0'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{title} — Portfolio design lab</title>
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip" href="#experiment">Skip to experiment</a>
    <header class="labbar">
      <a class="labbrand" href={href('/design-lab/')}>Design lab <span>Batch 02</span></a>
      <nav aria-label="Experiment routes">
        {variants.map((item) => (
          <a
            class:list={['labnum', item === variant && 'active']}
            href={href(`/design-lab/${item}/`)}
            aria-current={item === variant ? 'page' : undefined}
          >{item}</a>
        ))}
      </nav>
      <a class="baseline" href={href('/')}>Production baseline ↗</a>
    </header>
    <main id="experiment"><slot /></main>
  </body>
</html>

<style>
  :global(html) { background: #f2f0ea; }
  :global(body) { min-width: 0; overflow-x: clip; }
  .labbar {
    min-height: 52px; padding: 7px clamp(16px, 3vw, 40px);
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center; gap: 24px; background: #111; color: #f7f4ec;
    border-bottom: 1px solid #333; font: 12px/1 var(--mono);
    position: relative; z-index: 50;
  }
  .labbrand, .baseline, .labnum { text-decoration: none; }
  .labbrand, .baseline { display: inline-flex; align-items: center; min-height: 24px; }
  .labbrand { gap: 9px; font-weight: 600; }
  .labbrand span { color: #9a9a94; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
  nav { display: flex; justify-content: center; gap: 4px; }
  .labnum {
    width: 32px; height: 32px; display: grid; place-items: center;
    border: 1px solid #464641; color: #aaa9a3;
  }
  .labnum:hover, .labnum.active { color: #111; background: #e8ff4f; border-color: #e8ff4f; }
  .baseline { color: #cccac3; white-space: nowrap; }
  .baseline:hover { color: #e8ff4f; }
  @media (max-width: 760px) {
    .labbar { grid-template-columns: 1fr auto; gap: 8px; padding: 8px 16px; }
    .labbar nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; overflow-x: auto; padding-bottom: 2px; }
    .baseline { justify-self: end; }
    .labnum { flex: 0 0 auto; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .labnum, .baseline { transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease; }
  }
</style>
