---
import '../styles/tokens.css';
import { identity, contact } from '../data/portfolio.js';
import { href, homeAnchor } from '../lib/paths.js';
// Imported rather than written as a path, so the preload URL is the same hashed,
// base-prefixed URL the stylesheet asks for. A hand-written /fonts/... preload
// silently fetched nothing once the fonts moved into the asset pipeline.
import sansLatin from '../assets/fonts/plex-sans-var-latin.woff2';
import sansLatinExt from '../assets/fonts/plex-sans-var-latin-ext.woff2';

const { title, description } = Astro.props;

// Absolute so the header works identically on /, /work/ and /work/<slug>/. The
// first version used bare fragments, which silently pointed at anchors that only
// existed on the home page.
// "Contact" and "Get in touch" were two labels on one destination, which is a
// duplicated stop for anyone tabbing and a wasted slot in a four-item nav.
const nav = [
  { href: homeAnchor('work'), label: 'The systems' },
  { href: homeAnchor('help'), label: 'What I build' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="dark" />
  <!-- Preload only the two faces the first screen actually needs: the variable
       sans for both Latin subsets. The mono is metadata-only and can arrive late
       without the headline reflowing. -->
  <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sansLatinExt} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="data:," />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="top">
    <div class="wrap">
      <a class="brand" href={href('/')}>
        <b>{identity.name}</b><span class="label">{identity.role}</span>
      </a>
      <nav class="nav" aria-label="Sections">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a class="cta-sm" href="#contact">Get in touch <span aria-hidden="true">→</span></a>
      <button class="menu" type="button" aria-expanded="false" aria-controls="m-nav">
        <span class="sr">Menu</span><i></i><i></i><i></i>
      </button>
    </div>
    <nav class="m-nav" id="m-nav" hidden aria-label="Sections">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a class="m-cta" href="#contact">Get in touch</a>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <!-- Left-aligned and asymmetric like the rest of the page. A centred block
       with a button under it is the one shape every template footer has, and it
       was the last place this page still looked like one. -->
  <footer class="foot" id="contact">
    <div class="wrap">
      <p class="eyebrow mono label">Contact</p>
      <div class="grid">
        <div>
          <h2>Tell me what’s breaking.</h2>
          <p class="say">
            You don’t need a spec or a budget to start. Describe the problem in a
            sentence and I’ll tell you straight whether I’m the right person for
            it — and if I’m not, I’ll say so.
          </p>
        </div>
        <dl class="ways">
          <div>
            <dt class="mono label">Email</dt>
            <dd><a class="big" href={`mailto:${contact.email}`}>{contact.email}</a></dd>
          </div>
          <div>
            <dt class="mono label">Read the code first</dt>
            <dd><a href={contact.github}>github.com/sutasmantas</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </footer>

<style>
  .top {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .top > .wrap { display: flex; align-items: center; gap: var(--s-4); height: 60px; }
  /* min-height, not just the text box: as a flex item this link is not covered by
     the inline exception in WCAG 2.5.8, so it has to earn its own 24px. */
  .brand {
    display: flex; align-items: baseline; gap: var(--s-2); min-height: 40px;
    text-decoration: none; white-space: nowrap;
  }
  .brand b {
    font-family: var(--display); font-size: var(--t-500); font-weight: 700;
    font-stretch: 108%; letter-spacing: -0.012em;
  }
  .brand span { color: var(--muted); }

  .nav {
    display: flex; gap: var(--s-6); margin-left: auto; margin-right: var(--s-8);
    font-size: var(--t-300); color: var(--text-2);
  }
  .nav a { text-decoration: none; }
  .nav a:hover { color: var(--text); }

  /* A filled pill on the right of a sticky bar is the most recognisable
     component-library shape there is, and it sat on every page. This is a
     ruled text link instead: still obviously the primary action, no longer
     borrowed from a UI kit. */
  .cta-sm {
    color: var(--accent); font-weight: 600; font-size: var(--t-300);
    text-decoration: none; white-space: nowrap;
    padding-bottom: 2px; border-bottom: 1px solid var(--accent-dim);
  }
  .cta-sm:hover { border-bottom-color: var(--accent); }

  /* Two header designs, not one that wraps. The wrapping version collapsed into
     three rows with the button overlapping the brand. */
  .menu {
    display: none; background: transparent; border: 1px solid var(--line-ctl);
    border-radius: var(--r-sm); width: 40px; height: 40px; cursor: pointer; position: relative;
  }
  .menu i { position: absolute; left: 11px; right: 11px; height: 1.5px; background: var(--text); border-radius: 2px; }
  .menu i:nth-child(2) { top: 14px; }
  .menu i:nth-child(3) { top: 19px; }
  .menu i:nth-child(4) { top: 24px; }

  .m-nav { display: none; }
  .m-nav[hidden] { display: none; }

  @media (max-width: 620px) {
    .nav, .cta-sm { display: none; }
    .menu { display: block; }
    .m-nav:not([hidden]) {
      display: flex; flex-direction: column;
      border-top: 1px solid var(--line); background: var(--bg-lift);
    }
    .m-nav a {
      padding: var(--s-4) var(--gut); text-decoration: none; color: var(--text-2);
      border-bottom: 1px solid var(--line); font-size: var(--t-500);
    }
    .m-nav .m-cta { color: var(--accent); font-weight: 650; border-bottom: 0; }
  }

  .foot {
    border-top: 1px solid var(--line); background: var(--bg-lift);
    padding-block: var(--s-20);
  }
  .foot .eyebrow {
    display: inline-flex; align-items: center; gap: var(--s-3);
    color: var(--accent); margin-bottom: var(--s-8);
  }
  .foot .eyebrow::before { content: ""; width: var(--s-8); height: 1px; background: var(--accent-dim); }
  .foot .grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: var(--s-12); align-items: start;
    padding-top: var(--s-8); border-top: 1px solid var(--line);
  }
  .foot h2 {
    font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.05;
    letter-spacing: -0.032em; margin-bottom: var(--s-4);
  }
  .foot .say { color: var(--text-2); max-width: 46ch; }

  .ways { display: grid; gap: var(--s-6); margin: 0; }
  .ways div { display: grid; gap: var(--s-2); padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }
  .ways dt { color: var(--muted); }
  .ways dd { margin: 0; }
  .ways a { color: var(--text-2); text-decoration: none; font-size: var(--t-400); }
  .ways a:hover { color: var(--accent); }
  .ways a.big { color: var(--accent); font-size: var(--t-600); font-weight: 600; letter-spacing: -0.012em; }

  @media (max-width: 900px) {
    .foot .grid { grid-template-columns: 1fr; gap: var(--s-8); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn, .cta-sm, .nav a { transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  }
</style>

<script>
  const btn = document.querySelector('.menu');
  const panel = document.getElementById('m-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    panel.hidden = open;
  });
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    })
  );
</script>
</body>
</html>
