---
import { Image } from 'astro:assets';
import { shotFor } from '../data/shots.js';
import { href } from '../lib/paths.js';

// One card definition for both the featured strip and the full index, so the
// two can never drift apart.
//
// The card sells; the detail page qualifies. An earlier version printed each
// project's scope note on every card in the grid, which meant a visitor
// scanning thirteen systems read thirteen caveats before reading a single
// outcome. Scope belongs on the detail page, where someone has already decided
// they are interested.
const { project } = Astro.props;
const p = project;
const img = shotFor(p.shot);
---
<article class="card" data-family={p.family} data-route={p.route}>
  <a class="thumb" href={href(`/work/${p.slug}/`)} tabindex="-1" aria-hidden="true">
    <Image src={img} alt="" widths={[420, 720, 1100]} sizes="(max-width: 620px) 92vw, 380px" loading="lazy" />
  </a>
  <div class="body">
    <div class="tags">
      <span class="mark mono label">{p.name}</span>
      <span class="pill mono label">{p.family}</span>
    </div>
    <h3><a href={href(`/work/${p.slug}/`)}>{p.title}</a></h3>
    <p>{p.blurb}</p>
    <dl class="kv">
      <div><dt class="label">What you get</dt><dd>{p.asks}</dd></div>
      {p.note && (
        <div><dt class="label">The hard part</dt><dd>{p.note}</dd></div>
      )}
    </dl>
    <div class="acts">
      <a class="act" href={p.live}>Open it<span class="sr"> — {p.name}, live</span></a>
      <a class="act plain" href={href(`/work/${p.slug}/`)}>How it works<span class="sr"> — {p.name}</span></a>
    </div>
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden;
    background: var(--panel); display: flex; flex-direction: column;
    box-shadow: var(--sh-1);
  }
  /* The thumbnail is a duplicate of the title link, so it is hidden from the
     keyboard and the accessibility tree rather than adding a second stop. */
  .thumb {
    display: block; border-bottom: 1px solid var(--line); background: var(--mat);
    overflow: hidden; aspect-ratio: 16 / 10; padding: var(--s-2) var(--s-2) 0;
  }
  /* inner = outer − padding: 12 − 8 = 4, so the screenshot stays concentric
     inside the card instead of drifting against its corner. */
  .thumb :global(img) {
    display: block; width: 100%; height: auto;
    border-radius: var(--s-1) var(--s-1) 0 0;
  }

  .body {
    padding: var(--s-5); display: flex; flex-direction: column;
    gap: var(--s-3); flex: 1;
  }
  .tags { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }
  .mark { color: var(--accent); font-weight: 500; }
  .pill {
    color: var(--muted); border: 1px solid var(--line);
    border-radius: var(--r-sm); padding: 3px var(--s-2);
  }
  /* The descriptive title is the heading because it is what a buyer searches
     for and what carries meaning in an F-pattern scan; "Atlas" carries none. */
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .body > p {
    color: var(--text-2); font-size: var(--t-400);
    line-height: var(--lh-body); flex: 1;
  }

  /* A fixed two-column grid, not flex-wrap. Under flex-wrap the two rows sat
     side by side on short text and stacked on long text, so no two cards in the
     grid agreed on where the metadata was. */
  .kv {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3) var(--s-4);
    margin: 0; padding-top: var(--s-3); border-top: 1px solid var(--line);
  }
  .kv div { display: grid; gap: var(--s-1); align-content: start; }
  .kv div:only-child { grid-column: 1 / -1; }
  .kv dt { color: var(--muted); }
  .kv dd { margin: 0; font-size: var(--t-300); line-height: 1.45; color: var(--text); }

  .acts { display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .act {
    font-size: var(--t-300); color: var(--accent); text-decoration: none;
    border: 1px solid var(--accent-dim); border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
  }
  .act:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .act.plain { border-color: var(--line-ctl); color: var(--text-2); }
  .act.plain:hover { background: color-mix(in srgb, var(--text) 7%, transparent); color: var(--text); }

  @media (max-width: 620px) {
    .thumb { aspect-ratio: auto; height: 160px; }
    .thumb :global(img) { width: 168%; max-width: none; transform: translateY(-6%); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .card { transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
    .card:hover { border-color: var(--line-bright); transform: translateY(-2px); box-shadow: var(--sh-2); }
    .act { transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  }
</style>
