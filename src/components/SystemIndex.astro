---
import { ordered } from '../data/portfolio.js';
import { href } from '../lib/paths.js';

// An index, not a card grid.
//
// Thirteen identical cards in a three-column grid is the single most common
// layout on the web for showing work, and it was the largest template signal on
// this page. This is a catalogue instead: numbered rows, one large preview.
//
// The split follows the evidence rather than taste. Jakob's Law costs are all
// documented in the *interaction* layer — navigation placement, unfamiliar
// paradigms, non-standard controls — so interaction stays conventional here:
// every row is an ordinary link, tab order is source order, and the preview is
// an enhancement that nothing depends on. The distinctiveness is spent in the
// *visual* layer, where no such cost is documented.
//
// Tuch et al. (IJHCS 2012) find low visual complexity wins the sub-second
// judgement, and a ruled numeric index is far lower complexity than thirteen
// cards each carrying an image, two metadata columns and two buttons. So this
// should read better at a glance as well as at a minute.
//
// Each row offers two destinations rather than one. Under information foraging
// theory (Pirolli & Card; the SNIF-ACT model) people follow the link whose label
// carries the strongest scent for their task, and abandon a page when scent
// falls below a threshold. The task most visitors have here is "show me it
// working", and that action used to be two hops away — reachable only after
// opening the project page. "Open ↗" now sits in the row beside the title, so
// the highest-value action carries the highest-scent label.
//
// And the preview runs the software rather than picturing it. In this project's
// own reference scoring (central_portfolio_research/REFERENCE_MATRIX.csv) the
// only two sites that scored 15/15 on working-evidence visibility both did the
// same thing: linear.app embeds a real interface with real data rather than a
// mockup, and raycast.com uses interactive elements to demonstrate the mechanic
// instead of describing it. That pattern was recorded as transferable and then
// never applied — this page claimed thirteen systems you can open and showed
// photographs of them.
//
// All thirteen are static builds on the same origin as this page and send no
// framing restrictions, so they can be embedded directly. Nothing is framed
// until asked for: the button creates exactly one iframe, and switching or
// closing tears it down again, so the cost is zero for anyone who never presses
// it. The frame is rendered at desktop width and scaled down, because these are
// dense operator interfaces that would reflow into something unrepresentative
// if handed a 600px viewport.
const rows = ordered;
---
<div class="index" data-index>
  <ol class="rows" data-rows>
    {rows.map((p) => (
      <li class="row" data-route={p.route} data-slug={p.slug}>
        <span class="num mono">{String(p.order).padStart(2, '0')}</span>
        <span class="body">
          <a class="ttl" href={href(`/work/${p.slug}/`)} data-row>{p.title}</a>
          <span class="blurb">{p.blurb}</span>
          <span class="meta mono">
            <span class="mark">{p.name}</span>
            <span class="sep" aria-hidden="true">/</span>
            <span>{p.family}</span>
          </span>
          <span class="hard mono">{p.note}</span>
        </span>
        <a class="open mono" href={p.live}>
          Open<span class="sr"> {p.name}, live</span> <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>

</div>

<style>
  /* Full width. The preview column moved to the fold, where the system runs
     rather than being pictured, so the catalogue gets the whole measure and the
     titles can carry real size. */
  .index { display: block; }

  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-bright); }
  .row { border-bottom: 1px solid var(--line); }
  .row[hidden] { display: none; }

  .row {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline; gap: var(--s-6);
    padding: var(--s-5) var(--s-2);
  }
  .ttl { display: block; text-decoration: none; color: inherit; }
  .ttl:hover { color: var(--accent); }
  .open {
    align-self: center; white-space: nowrap; text-decoration: none;
    font-size: var(--t-200); color: var(--muted);
    border: 1px solid var(--line-bright); border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
  }
  .open:hover { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }
  /* Scale contrast between the number and the title is doing the compositional
     work — without it every row competes equally and the field reads as flat. */
  /* --line-bright is a hairline colour and was used here for a decorative
     effect, which put real text at 1.64:1. The index number is content: it is
     how a reader refers to a row. --muted clears 4.5:1. */
  .num {
    font-size: var(--t-600); color: var(--muted);
    font-weight: 500; font-variant-numeric: tabular-nums;
  }
  .body { display: grid; gap: var(--s-2); min-width: 0; }
  /* Shown only where there is no preview pane to carry it. */
  .blurb { display: block; color: var(--text-2); font-size: var(--t-300); max-width: 68ch; }
  .ttl {
    font-family: var(--display);
    font-size: clamp(1.125rem, 1.9vw, 1.5rem); line-height: 1.2;
    letter-spacing: -0.022em; font-weight: 700; text-wrap: balance;
  }
  .meta {
    font-size: var(--t-200); color: var(--muted);
    display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: baseline;
  }
  .meta .mark { color: var(--accent); }
  .sep { color: var(--line-ctl); }
  /* Its own line at every width. Inline after the family it wrapped, which left
     the separator dangling at the end of a line whenever the column narrowed. */
  .hard {
    font-size: var(--t-200); color: var(--text-2);
    position: relative; padding-left: var(--s-4);
  }
  .hard::before {
    content: ""; position: absolute; left: 0; top: 0.52em;
    width: 7px; height: 1px; background: var(--accent-dim);
  }

  .row.on .num { color: var(--accent); }
  .row.on { background: var(--panel); }

  /* The live stage. Rendered at desktop width and scaled to fit, so the app
     lays out as it was designed instead of collapsing to a phone breakpoint. */
  /* Below the two-column threshold the preview is dropped rather than stacked.
     A phone cannot show a row and its preview at once, so the preview would be
     an image the reader has to scroll past thirteen times to reach the list. */
  @media (max-width: 1000px) {
    .row { padding: var(--s-4) 0; gap: var(--s-4); }
  }
  @media (max-width: 620px) {
    .row { grid-template-columns: auto minmax(0, 1fr); row-gap: var(--s-3); }
    .open { grid-column: 2; justify-self: start; }
    /* The meta wraps at this width and left the separator dangling at the end
       of the line. Give the result its own row and drop the divider. */

  }

  @media (prefers-reduced-motion: no-preference) {
    .num, .open, .ttl, .row { transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  }
</style>

<script>
  // The rows carry their own links, so nothing here is required for the page to
  // work — this only syncs the hero stage with the row a visitor is reading, so
  // hovering row 09 puts DeliveryGuard on the screen above.
  const index = document.querySelector('[data-index]');
  const tabs = Array.from(document.querySelectorAll('[data-tab]'));
  if (index && tabs.length) {
    for (const row of index.querySelectorAll('.row')) {
      const tab = tabs.find((t) => t.dataset.tab === row.dataset.slug);
      if (!tab) continue;
      const mark = () => {
        for (const r of index.querySelectorAll('.row')) r.classList.toggle('on', r === row);
      };
      row.addEventListener('mouseenter', mark);
      for (const link of row.querySelectorAll('a')) link.addEventListener('focus', mark);
    }
  }
</script>
